rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation helper for UserProfile
    function isValidUserProfile(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 && data.id == request.auth.uid
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('createdAt' in data) || data.createdAt is timestamp)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // Validation helper for UserSummary
    function isValidUserSummary(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.videoId is string && data.videoId.size() > 0 && data.videoId.size() <= 64
        && data.videoTitle is string && data.videoTitle.size() > 0 && data.videoTitle.size() <= 512
        && (!('videoChannel' in data) || (data.videoChannel is string && data.videoChannel.size() <= 256))
        && (!('videoThumbnail' in data) || (data.videoThumbnail is string && data.videoThumbnail.size() <= 1024))
        && data.tldr is string && data.tldr.size() > 0 && data.tldr.size() <= 4096
        && (!('language' in data) || (data.language is string && data.language.size() <= 16))
        && (!('summaryLength' in data) || (data.summaryLength is string && data.summaryLength.size() <= 32))
        && (!('style' in data) || (data.style is string && data.style.size() <= 32))
        && data.summaryData is string && data.summaryData.size() > 0 && data.summaryData.size() <= 500000
        && (!('isBookmarked' in data) || data.isBookmarked is bool)
        && (!('bookmarkedAt' in data) || data.bookmarkedAt is timestamp)
        && (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // Test connection doc for validating client connectivity
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming());

      allow update: if isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().id == existing().id;

      allow delete: if isValidId(userId) && isOwner(userId);

      // User Summaries Subcollection
      match /summaries/{summaryId} {
        allow get: if isValidId(userId) && isValidId(summaryId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);

        allow create: if isValidId(userId) && isValidId(summaryId) && isOwner(userId)
          && isValidUserSummary(incoming());

        allow update: if isValidId(userId) && isValidId(summaryId) && isOwner(userId)
          && isValidUserSummary(incoming())
          && incoming().id == existing().id
          && incoming().userId == existing().userId;

        allow delete: if isValidId(userId) && isValidId(summaryId) && isOwner(userId);
      }
    }
  }
}
